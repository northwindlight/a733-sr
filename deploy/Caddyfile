# A733 视频超分 —— 板上 HTTP 反代
# http://radxa.lan/ 为域名入口，:80 保留 IP 访问。
# 显式 http:// 避免为 .lan 自动申请 HTTPS；DNS 由局域网路由器提供。
http://radxa.lan, :80 {
	encode gzip
	reverse_proxy 127.0.0.1:8080 {
		# 大文件上传/下载不要缓冲，否则进度条会卡在 100% 不动
		flush_interval -1
		transport http {
			read_timeout 1h
			write_timeout 1h
		}
	}
	log {
		output file /var/log/caddy/sr.log
		format console
	}
}
